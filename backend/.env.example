DATABASE_URL=sqlite:///./bovet.db
SECRET_KEY=replace-with-at-least-32-random-characters
OTP_HMAC_KEY=replace-with-a-different-32-character-random-key
OTP_EXPIRY_MINUTES=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-google-workspace-or-gmail-address
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-google-workspace-or-gmail-address
# For hosted deployments, prefer Brevo HTTPS delivery because SMTP ports may be blocked.
# BREVO_API_KEY=your-brevo-api-key
APP_ORIGIN=http://localhost:5173
# For hosted deployments, use a comma-separated list if more than one frontend origin is needed.
# APP_ORIGIN=https://your-frontend.onrender.com
